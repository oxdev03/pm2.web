    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@pm2.web/mongoose-models": "workspace:*",
    "@pm2.web/typings": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.103.1",
    "@trpc/client": "^11.19.0",
    "@trpc/next": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
