  },
  "bugs": {
    "url": "https://github.com/oxdev03/pm2.web/issues"
  },
  "scripts": {
    "dev": "dotenv -v DB_URI=mongodb://127.0.0.1:27018/ -- next dev",
    "dev:db": "node scripts/start-db.mjs",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "test:server": "dotenv -v NODE_ENV=test -- next start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "playwright test",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mantine/charts": "^9.6.1",
    "@mantine/code-highlight": "^9.6.1",
