    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "lodash": "^4.18.1",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.10.1",
    "ms": "^2.1.3",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
